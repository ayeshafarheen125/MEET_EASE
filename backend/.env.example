# MeetEase backend environment variables
# Copy this file to .env and fill in real values.

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# AssemblyAI (speech-to-text): https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# JWT signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your_jwt_secret_here

# Gmail SMTP (use an App Password: https://myaccount.google.com/apppasswords)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://meeteasefrontend-jet.vercel.app